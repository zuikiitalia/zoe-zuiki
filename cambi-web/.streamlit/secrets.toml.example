# -----------------------------------------------------------------------------
# ESEMPIO di configurazione segreta per la versione web di Cambi PDF.
#
# NON mettere qui i valori veri e NON caricare questo file (con i token) su
# GitHub. Su Streamlit Community Cloud incolli questi valori nella sezione
# "Secrets" dell'app (Settings → Secrets), dove restano cifrati sul server.
#
# In locale, per provare l'app: copia questo file in  .streamlit/secrets.toml
# e riempi i valori.
# -----------------------------------------------------------------------------

# Password unica per far entrare il team. Lascia "" per accesso senza password.
app_password = "scegli-una-password"

# Token API Rich Returns per ciascun profilo.
zuiki_token = "INCOLLA_QUI_IL_TOKEN_ZUIKI"
loveskin_token = "INCOLLA_QUI_IL_TOKEN_LOVESKIN"

# (Opzionale) indirizzi in copia fissa per profilo.
zuiki_fixed_cc = "a.giugliano@zuiki.it"
loveskin_fixed_cc = ""
